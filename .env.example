# Copy to .env and adjust. Never commit real secrets.

ENV=development
PORT=6969

# PostgreSQL connection string (required in production).
DATABASE_URL=postgres://sokomoko:sokomoko@localhost:5432/sokomoko?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_QUERY_TIMEOUT_SECONDS=10

# Hosts the app answers on (required in production).
ALLOWED_HOSTS=localhost,127.0.0.1,admin.localhost,partner.localhost
# SESSION_COOKIE_DOMAIN=.example.com

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For
# and X-Forwarded-Proto.
TRUST_PROXY_HEADERS=false

# Logging: json or text (json is the production default).
LOG_FORMAT=text
LOG_LEVEL=info

# First-run admin bootstrap. Either use ADMIN_SETUP_TOKEN with /setup on the
# admin host, or seed an admin with ADMIN_PASSWORD (10-72 bytes).
ADMIN_SETUP_TOKEN=
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Abuse protection.
POST_RATE_LIMIT_MAX=0
POST_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_ABUSE_MAX_FAILURES=5
AUTH_ABUSE_BACKOFF_BASE_SECONDS=1
AUTH_ABUSE_BACKOFF_MAX_SECONDS=300

# Password recovery requires an HTTPS allowed origin and SMTP in production.
# Production SMTP must support STARTTLS (normally port 587).
PASSWORD_RESET_BASE_URL=http://localhost:6969
# Public storefront origin for payment return and callback URLs.
PUBLIC_BASE_URL=http://localhost:6969
# Seal online provider credentials (openssl rand -base64 32). Development uses
# a fixed local key when this is empty.
SECRETS_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com

# Tests: a database the test suite may create and drop schemas in.
SOKOMOKO_TEST_DATABASE_URL=postgres://sokomoko:sokomoko@localhost:5432/sokomoko_test?sslmode=disable
