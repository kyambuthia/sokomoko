# Copy to .env.production at the repository root and chmod 600 it.
# Set real values through the deployment platform's secret store in production.
# This file contains examples only. Compose --env-file does not execute shell.
SOKOMOKO_IMAGE=ghcr.io/your-organization/sokomoko@sha256:REPLACE_WITH_TESTED_DIGEST
STOREFRONT_HOST=shop.example.com
# Routing requires these admin. and partner. hostname prefixes.
ADMIN_HOST=admin.example.com
PARTNER_HOST=partner.example.com
TLS_EMAIL=operations@example.com

# Prefer a managed PostgreSQL 17 instance with automated point-in-time recovery.
# The runtime connection needs DML and SELECT on schema_migrations, not DDL.
DATABASE_URL=postgres://sokomoko_app:REPLACE@db.example.com/sokomoko?sslmode=verify-full
# Only the one-shot migration container receives the DDL-capable connection.
MIGRATION_DATABASE_URL=postgres://sokomoko_migrate:REPLACE@db.example.com/sokomoko?sslmode=verify-full
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_QUERY_TIMEOUT_SECONDS=10

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=support@example.com
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE

# Generate with: openssl rand -base64 32. Keep this key across app restarts and
# database restores; changing it makes stored provider credentials unreadable.
SECRETS_KEY=REPLACE_WITH_32_RANDOM_BYTES_AS_BASE64
SECRETS_KEY_PREVIOUS=

# Use a random token of at least 32 bytes for first-run /setup on the admin host.
# Remove it after setup. Do not seed demo data in production.
ADMIN_SETUP_TOKEN=REPLACE_WITH_A_RANDOM_SETUP_TOKEN
# Keep empty for independent host-only sessions. All hosts must share a suffix
# if you deliberately enable shared cookies, e.g. .example.com.
SESSION_COOKIE_DOMAIN=

# These limits are per process; deploy one app instance until limits are shared.
POST_RATE_LIMIT_MAX=120
AUTH_ABUSE_MAX_FAILURES=5
LOG_LEVEL=info
